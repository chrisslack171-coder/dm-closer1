# Auto Poster — Zernio config
# Copy this file to ".env" (same folder) and fill in your own values.
#   cp .env.example .env
#
# Where to get these:
#   - ZERNIO_API_KEY: Zernio dashboard -> Settings -> API. Starts with "sk_".
#   - Account IDs:    one per connected social account. You don't have to hunt
#                     for these by hand — once your API key is set, just ask
#                     Claude: "fetch my Zernio account IDs". It calls
#                     GET https://zernio.com/api/v1/accounts and fills them in.

# Required
ZERNIO_API_KEY=

# One account ID per platform you post to. Delete the lines you don't use.
ZERNIO_ACCOUNT_INSTAGRAM=
ZERNIO_ACCOUNT_TIKTOK=
ZERNIO_ACCOUNT_YOUTUBE=
ZERNIO_ACCOUNT_LINKEDIN=
ZERNIO_ACCOUNT_THREADS=

# Optional
ZERNIO_API_URL=https://zernio.com/api/v1
ZERNIO_TIMEZONE=America/Chicago

# Only needed for the "addToQueue" posting mode:
# ZERNIO_PROFILE_ID=
# ZERNIO_QUEUE_ID=
