# Copy this file to ".env" in the zernio/ folder and fill in your values.
# The .env file stays on your machine and is git-ignored — your key never leaves your PC.

# Required: your Zernio API key (https://zernio.com -> settings -> API keys)
ZERNIO_API_KEY=sk_your_key_here

# Required for watch mode: the folder to monitor for new videos.
# Windows example (note: forward slashes work fine in Node):
ZERNIO_WATCH_DIR=C:/Users/chris/Videos/Captures

# Which connected accounts to post drafts to (comma-separated).
ZERNIO_PLATFORMS=instagram,tiktok

# Default caption applied to every draft. Leave blank for none.
# Tip: to caption a specific video, drop a text file next to it with the same
# name (e.g. "clip.mp4" -> "clip.txt"); that overrides this default.
ZERNIO_CAPTION=

# TikTok draft privacy level (must be allowed for your creator account).
ZERNIO_TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# How long (ms) a file's size must stay unchanged before we treat the recording
# as finished and upload it. Bump this up if large recordings get posted early.
ZERNIO_STABLE_MS=3000
