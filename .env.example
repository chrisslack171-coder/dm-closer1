# =============================================================================
# Environment variables for DM Closer
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for LOCAL development:
#     cp .env.example .env
#
# NEVER commit `.env` — it is gitignored. In production, set these in your host
# (Vercel → Project → Settings → Environment Variables), not in any file.
# If a key has ever been pasted into chat, email, or a commit, rotate it.
# =============================================================================

# Anthropic API key used by api/close.js to call the Claude API server-side.
# Format: sk-ant-...  (create/rotate at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Placeholder for the Zernio API key referenced during setup.
# Not currently read by any code in this repo — wire it up in api/close.js
# (via process.env.ZERNIO_API_KEY) before it takes effect.
ZERNIO_API_KEY=
